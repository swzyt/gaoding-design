{
  "name": "dsh-plugin-gaoding-publisher",
  "version": "0.44.4",
  "description": "话题与创作规范控制台：实时话题、公开规范库、登录态检测与后续创作投稿",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "runtime-host.js",
    "topic-catalog.js",
    "spec-catalog.js",
    "browser-session.js",
    "jobs-store.js",
    "publish-check.js",
    "prompt-writer.js",
    "creator.js",
    "published.js",
    "template-recipe.js",
    "publisher.js",
    "publication-safety.js",
    "publication-reconcile.js",
    "template-publish.js",
    "editor-import.js",
    "ai-evidence.py",
    "original-evidence.py",
    "runner.js",
    "client.js",
    "cordis.patch.yml",
    "skill",
    "runtime",
    "locale",
    "icon.svg",
    "README.md",
    "USAGE.md",
    "template-declaration.js",
    "auto-publish.js",
    "browser-space.js",
    "asset-handoff.js",
    "publish-queue.js",
    "image-client.js",
    "CHANGELOG.md",
    "preflight.js",
    "usage-doc.js",
    "delete-rejected.js"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "license": "UNLICENSED",
  "os": [
    "darwin"
  ],
  "scripts": {
    "prepack": "node ../scripts/prepare-plugin.mjs",
    "test": "node --test test-plugin.mjs"
  }
}
